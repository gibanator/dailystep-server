# PostgreSQL
POSTGRES_DB=db_name
POSTGRES_USER=uname
POSTGRES_PASSWORD=change-me

# GigaChat (Sber) 
GIGACHAT_API_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# dev: true пропускает проверку TLS-сертификата. В проде — false + сертификаты Минцифры.
GIGACHAT_UNSAFE_SSL=true
GIGACHAT_MODEL=GigaChat

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash